# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── PostgreSQL (docker compose) ─────────────────────────────────────────────
POSTGRES_USER=mybricks
POSTGRES_PASSWORD=mybricks
POSTGRES_DB=mybricks
POSTGRES_PORT=5433
DATABASE_URL=postgresql://mybricks:mybricks@localhost:5433/mybricks?schema=public

# -- Better Auth --------------------------------------------------------------
# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=change-me-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
# Guest/demo workspace lifetime
DEMO_TTL_HOURS=24
# Optional Google sign-in (leave unset to disable)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# -- Object storage (photos, documents, contract PDFs) -------------------------
# local: files in a folder (development). s3: any S3-compatible bucket (R2, B2, MinIO, AWS...).
STORAGE_DRIVER=local
STORAGE_DIR=.data/storage
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
# Largest accepted upload, in megabytes
MAX_UPLOAD_MB=15
