# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── PostgreSQL (docker compose) ─────────────────────────────────────────────
POSTGRES_USER=mybricks
POSTGRES_PASSWORD=mybricks
POSTGRES_DB=mybricks
POSTGRES_PORT=5433
DATABASE_URL=postgresql://mybricks:mybricks@localhost:5433/mybricks?schema=public

# -- Better Auth --------------------------------------------------------------
# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=change-me-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
# Guest/demo workspace lifetime
DEMO_TTL_HOURS=24
# Optional Google sign-in (leave unset to disable)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
